{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:magic-simulation:request:6",
  "$comment": "Current development contract; shared fragments are bundled in magic-common.schema.json.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "6"
    },
    "kind": {
      "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_kind"
    },
    "request_id": {
      "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_request_id"
    },
    "ruleset": {
      "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_ruleset"
    },
    "simulation": {
      "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_simulation"
    },
    "execution": {
      "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_execution"
    },
    "scenario": {
      "$ref": "urn:towr:magic-simulation:request:6#/$defs/scenario"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "request_id",
    "ruleset",
    "simulation",
    "execution",
    "scenario"
  ],
  "additionalProperties": false,
  "$defs": {
    "scenario": {
      "type": "object",
      "properties": {
        "scenario_id": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_scenario_id"
        },
        "definitions": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_definitions"
        },
        "actors": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_actors"
        },
        "battlefield": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_battlefield"
        },
        "placements": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_placements"
        },
        "side_order": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_side_order"
        },
        "activation_order": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_activation_order"
        },
        "perspective_side": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_perspective_side"
        },
        "objective_target_ids": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_objective_target_ids"
        },
        "facts": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_facts"
        },
        "wizard": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_wizard"
        },
        "spell": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_spell"
        },
        "actor_policies": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_actor_policies"
        },
        "scene_frames": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_scene_frames"
        },
        "repeated_stagger_choice": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scenario_repeated_stagger_choice"
        },
        "miscast_continuation": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_miscast_continuation"
        },
        "stationary_wound_continuation": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_stationary_wound_continuation"
        },
        "repeated_leg_spasm_continuation": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_repeated_leg_spasm_continuation"
        },
        "crushed_rib_continuation": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_crushed_rib_continuation"
        },
        "battered_leg_continuation": {
          "$ref": "urn:towr:magic-simulation:request:6#/$defs/battered_leg_continuation"
        }
      },
      "required": [
        "scenario_id",
        "definitions",
        "actors",
        "battlefield",
        "placements",
        "side_order",
        "activation_order",
        "perspective_side",
        "objective_target_ids",
        "facts",
        "wizard",
        "spell",
        "actor_policies",
        "scene_frames",
        "repeated_stagger_choice",
        "miscast_continuation",
        "stationary_wound_continuation",
        "repeated_leg_spasm_continuation",
        "crushed_rib_continuation",
        "battered_leg_continuation"
      ],
      "additionalProperties": false
    },
    "battered_leg_continuation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "endurance_profile": {
              "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_profile"
            },
            "prone_policy": {
              "enum": [
                null,
                "self_stand_when_safe",
                "recover_self"
              ]
            }
          },
          "required": [
            "endurance_profile",
            "prone_policy"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
