{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:pc-melee:simulation:error:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "kind": {
      "const": "pc_melee_simulation_error"
    },
    "request_id": {
      "anyOf": [
        {
          "$ref": "urn:towr:pc-melee:common:1#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_json",
            "unsupported_version",
            "invalid_input",
            "simulation_failed"
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "input",
            "simulation"
          ]
        },
        "candidate_id": {
          "type": "null"
        },
        "candidate_index": {
          "type": "null"
        }
      },
      "required": [
        "code",
        "path",
        "message",
        "phase",
        "candidate_id",
        "candidate_index"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "request_id",
    "error"
  ],
  "additionalProperties": false
}
