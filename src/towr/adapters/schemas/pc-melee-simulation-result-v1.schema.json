{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:pc-melee:simulation:result:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "kind": {
      "const": "pc_melee_simulation_result"
    },
    "request": {
      "$ref": "urn:towr:pc-melee:simulation:request:1"
    },
    "seed_scheme": {
      "const": "towr:pc-melee-trial:v1"
    },
    "runtime": {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/runtime"
    },
    "summary": {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/summary"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "request",
    "seed_scheme",
    "runtime",
    "summary"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/companionSummaryPresence"
    },
    {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/immediateAttackSummaryPresence"
    },
    {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/potionSummaryPresence"
    },
    {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/magicSummaryPresence"
    },
    {
      "if": {
        "properties": {
          "request": {
            "properties": {
              "scenario": {
                "properties": {
                  "party": {
                    "contains": {
                      "required": [
                        "pc"
                      ],
                      "properties": {
                        "pc": {
                          "required": [
                            "ranged"
                          ],
                          "properties": {
                            "ranged": {
                              "type": "object",
                              "required": [
                                "awareness"
                              ],
                              "properties": {
                                "awareness": {
                                  "type": "integer",
                                  "minimum": 1
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "required": [
                  "party"
                ]
              }
            },
            "required": [
              "scenario"
            ]
          }
        },
        "required": [
          "request"
        ]
      },
      "then": {
        "properties": {
          "summary": {
            "required": [
              "aim"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "summary": {
            "not": {
              "required": [
                "aim"
              ]
            }
          }
        }
      }
    },
    {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/npcRangedSummaryPresence"
    },
    {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/pcRangedSummaryPresence"
    },
    {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/musicSummaryPresence"
    },
    {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/oathSummaryPresence"
    }
  ]
}
