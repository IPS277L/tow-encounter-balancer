{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:magic-balance:request:6",
  "$comment": "Current development contract; shared fragments are bundled in magic-common.schema.json.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "6"
    },
    "kind": {
      "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_kind"
    },
    "ruleset": {
      "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_ruleset"
    },
    "request_id": {
      "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_request_id"
    },
    "reserve": {
      "type": "object",
      "properties": {
        "round_budget": {
          "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_reserve_round_budget"
        },
        "scenario": {
          "$ref": "urn:towr:magic-simulation:request:6#/$defs/scenario"
        }
      },
      "required": [
        "round_budget",
        "scenario"
      ],
      "additionalProperties": false
    },
    "generation": {
      "type": "object",
      "properties": {
        "groups": {
          "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_generation_groups"
        },
        "facts": {
          "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_generation_facts"
        },
        "candidate_id_prefix": {
          "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_generation_candidate_id_prefix"
        },
        "max_candidates": {
          "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_generation_max_candidates"
        },
        "scene_frames": {
          "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_generation_scene_frames"
        },
        "miscast_continuation": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_miscast_continuation"
        },
        "stationary_wound_continuation": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_stationary_wound_continuation"
        },
        "repeated_leg_spasm_continuation": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_repeated_leg_spasm_continuation"
        },
        "crushed_rib_continuation": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_crushed_rib_continuation"
        },
        "battered_leg_continuation": {
          "$ref": "urn:towr:magic-simulation:request:6#/$defs/battered_leg_continuation"
        }
      },
      "required": [
        "groups",
        "facts",
        "candidate_id_prefix",
        "max_candidates",
        "scene_frames",
        "miscast_continuation",
        "stationary_wound_continuation",
        "repeated_leg_spasm_continuation",
        "crushed_rib_continuation",
        "battered_leg_continuation"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_evaluation"
    },
    "execution": {
      "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_execution"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "ruleset",
    "request_id",
    "reserve",
    "generation",
    "evaluation",
    "execution"
  ],
  "additionalProperties": false
}
