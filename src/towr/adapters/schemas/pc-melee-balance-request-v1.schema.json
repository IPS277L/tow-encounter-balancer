{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:pc-melee:balance:request:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "kind": {
      "const": "pc_melee_balance"
    },
    "request_id": {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/identifier"
    },
    "ruleset": {
      "const": "towr-pg1.4-gmg1.1"
    },
    "template": {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/scenario"
    },
    "generation": {
      "type": "object",
      "properties": {
        "groups": {
          "type": "array",
          "items": {
            "$ref": "urn:towr:pc-melee:common:1#/$defs/group"
          },
          "minItems": 1
        },
        "facts": {
          "$ref": "urn:towr:pc-melee:common:1#/$defs/facts"
        },
        "max_candidates": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "groups",
        "facts",
        "max_candidates"
      ],
      "additionalProperties": false
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "master_seed": {
          "$ref": "urn:towr:pc-melee:common:1#/$defs/seed"
        },
        "trials_per_candidate": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_trials": {
          "type": "integer",
          "minimum": 1
        },
        "window": {
          "$ref": "urn:towr:pc-melee:common:1#/$defs/window"
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "master_seed",
        "trials_per_candidate",
        "max_total_trials",
        "window",
        "top_k"
      ],
      "additionalProperties": false
    },
    "execution": {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/execution"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "request_id",
    "ruleset",
    "template",
    "generation",
    "evaluation",
    "execution"
  ],
  "additionalProperties": false
}
