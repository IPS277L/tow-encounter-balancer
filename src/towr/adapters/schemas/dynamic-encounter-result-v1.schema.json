{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:dynamic-encounter:result:1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "kind": {
      "const": "dynamic_encounter_search_result"
    },
    "request_id": {
      "$ref": "urn:towr:pc-melee:common:1#/$defs/identifier"
    },
    "source_request": {
      "$ref": "urn:towr:dynamic-encounter:request:1"
    },
    "explored": {
      "type": "array",
      "items": {
        "$ref": "urn:towr:dynamic-encounter:common:1#/$defs/candidate"
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "$ref": "urn:towr:dynamic-encounter:common:1#/$defs/candidate"
      }
    },
    "selected": {
      "type": "array",
      "items": {
        "$ref": "urn:towr:pc-melee:common:1#/$defs/identifier"
      },
      "uniqueItems": true
    },
    "total_trials": {
      "type": "integer",
      "minimum": 0
    },
    "proposal_attempts": {
      "type": "integer",
      "minimum": 0
    },
    "proposal_limit_reached": {
      "type": "boolean"
    },
    "resolved_search_space": {
      "$ref": "urn:towr:dynamic-encounter:common:1#/$defs/search_space"
    },
    "target_criteria": {
      "type": "object",
      "properties": {
        "basis": {
          "const": "point_estimates"
        },
        "win_rate_tolerance": {
          "const": 0.1
        },
        "started_rounds_tolerance": {
          "const": 1
        }
      },
      "required": [
        "basis",
        "win_rate_tolerance",
        "started_rounds_tolerance"
      ],
      "additionalProperties": false
    },
    "target_match_found": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "request_id",
    "source_request",
    "explored",
    "validations",
    "selected",
    "total_trials",
    "proposal_attempts",
    "proposal_limit_reached",
    "resolved_search_space",
    "target_criteria",
    "target_match_found"
  ],
  "additionalProperties": false
}
