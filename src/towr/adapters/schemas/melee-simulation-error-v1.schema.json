{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:melee-simulation:error:1",
  "$comment": "Structural contract. Strict token spelling and semantic admission are adapter responsibilities.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "kind": {
      "type": "string",
      "const": "melee_simulation_error"
    },
    "request_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_json",
            "unsupported_version",
            "invalid_input",
            "execution_failed"
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$(?![\\s\\S])"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "kind",
    "request_id",
    "error"
  ],
  "additionalProperties": false
}
