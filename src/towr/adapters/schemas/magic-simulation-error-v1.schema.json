{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:magic-simulation:error:1",
  "$comment": "Structural contract. Strict token spelling and semantic admission are adapter responsibilities.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "kind": {
      "type": "string",
      "const": "magic_simulation_error"
    },
    "request_id": {
      "anyOf": [
        {
          "$ref": "urn:towr:magic-simulation:request:1#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_json",
            "unsupported_version",
            "invalid_input",
            "simulation_failed"
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "type": "string",
                "const": "simulation_failed"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "request_id",
    "error"
  ],
  "additionalProperties": false
}
