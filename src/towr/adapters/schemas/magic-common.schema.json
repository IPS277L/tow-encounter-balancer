{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:magic:common",
  "$comment": "Shared definitions for the sole current Magic JSON contract; no legacy request/result/error roots.",
  "$defs": {
    "magic_balance_error_error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_json",
            "unsupported_version",
            "invalid_input",
            "generation_failed",
            "evaluation_failed"
          ]
        },
        "path": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_error_error_path"
        },
        "message": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        "candidate_id": {
          "anyOf": [
            {
              "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "stage_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "path",
        "message",
        "candidate_id",
        "counts",
        "stage_index"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "invalid_json",
                  "unsupported_version",
                  "invalid_input"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "candidate_id": {
                "type": "null"
              },
              "counts": {
                "type": "null"
              },
              "stage_index": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "generation_failed"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "const": "/generation"
              },
              "stage_index": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "evaluation_failed"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "const": "/evaluation"
              },
              "counts": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "magic_balance_error_kind": {
      "type": "string",
      "const": "magic_balance_error"
    },
    "magic_balance_error_request_id": {
      "anyOf": [
        {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "magic_balance_request_evaluation": {
      "type": "object",
      "properties": {
        "master_seed": {
          "$ref": "urn:towr:magic:common#/$defs/ranged_simulation_request_simulation_master_seed"
        },
        "stages": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "trials_per_candidate": {
                "type": "integer",
                "minimum": 1,
                "maximum": 18446744073709551615
              },
              "keep": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "trials_per_candidate",
              "keep"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "max_total_trials": {
          "type": "integer",
          "minimum": 1
        },
        "window": {
          "type": "object",
          "properties": {
            "minimum": {
              "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_fraction"
            },
            "target": {
              "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_fraction"
            },
            "maximum": {
              "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_fraction"
            }
          },
          "required": [
            "minimum",
            "target",
            "maximum"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "master_seed",
        "stages",
        "max_total_trials",
        "window"
      ],
      "additionalProperties": false
    },
    "magic_balance_request_execution": {
      "$ref": "urn:towr:magic:common#/$defs/ranged_simulation_request_execution"
    },
    "magic_balance_request_fraction": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "magic_balance_request_generation_candidate_id_prefix": {
      "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
    },
    "magic_balance_request_generation_facts": {
      "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_facts"
    },
    "magic_balance_request_generation_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "group_id": {
            "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
          },
          "actor_ids": {
            "type": "array",
            "items": {
              "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "minimum_count": {
            "type": "integer",
            "minimum": 0
          },
          "maximum_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "group_id",
          "actor_ids",
          "minimum_count",
          "maximum_count"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "magic_balance_request_generation_max_candidates": {
      "type": "integer",
      "minimum": 1
    },
    "magic_balance_request_generation_scene_frames": {
      "type": "array",
      "items": {
        "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_scene_frame"
      },
      "minItems": 1
    },
    "magic_balance_request_kind": {
      "type": "string",
      "const": "npc_magic_balance"
    },
    "magic_balance_request_request_id": {
      "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
    },
    "magic_balance_request_reserve_round_budget": {
      "type": "integer",
      "minimum": 1
    },
    "magic_balance_request_ruleset": {
      "type": "string",
      "const": "towr-pg1.4-gmg1.1"
    },
    "magic_balance_result_candidate_count": {
      "type": "integer",
      "minimum": 1
    },
    "magic_balance_result_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
          },
          "counts": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1
          }
        },
        "required": [
          "candidate_id",
          "counts"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "magic_balance_result_kind": {
      "type": "string",
      "const": "npc_magic_balance_result"
    },
    "magic_balance_result_planned_trials": {
      "type": "integer",
      "minimum": 1
    },
    "magic_balance_result_runtime": {
      "$ref": "urn:towr:magic:common#/$defs/magic_simulation_result_runtime"
    },
    "magic_balance_result_seed_scheme": {
      "$ref": "urn:towr:magic:common#/$defs/magic_simulation_result_seed_scheme"
    },
    "magic_balance_result_selected_candidate_ids": {
      "type": "array",
      "items": {
        "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "magic_balance_result_stage_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stage_index": {
            "type": "integer",
            "minimum": 0
          },
          "trials_per_candidate": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18446744073709551615
          },
          "keep": {
            "type": "integer",
            "minimum": 1
          },
          "total_trials": {
            "type": "integer",
            "minimum": 1
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "candidate_id": {
                  "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
                },
                "summary": {
                  "$ref": "urn:towr:magic:common#/$defs/magic_simulation_result_summary"
                },
                "rates": {
                  "type": "object",
                  "properties": {
                    "objective_achieved": {
                      "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_fraction"
                    },
                    "perspective_defeated": {
                      "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_fraction"
                    },
                    "round_limit_reached": {
                      "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_fraction"
                    },
                    "unsupported_path": {
                      "$ref": "urn:towr:magic:common#/$defs/magic_balance_request_fraction"
                    }
                  },
                  "required": [
                    "objective_achieved",
                    "perspective_defeated",
                    "round_limit_reached",
                    "unsupported_path"
                  ],
                  "additionalProperties": false
                },
                "status": {
                  "enum": [
                    "eligible",
                    "unsupported_observations"
                  ]
                },
                "window_match": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              },
              "required": [
                "candidate_id",
                "summary",
                "rates",
                "status",
                "window_match"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "status": {
                        "const": "eligible"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "window_match": {
                        "type": "boolean"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "window_match": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            },
            "minItems": 1
          },
          "selected_candidate_ids": {
            "type": "array",
            "items": {
              "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "continuation_candidate_ids": {
            "type": "array",
            "items": {
              "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "stage_index",
          "trials_per_candidate",
          "keep",
          "total_trials",
          "candidates",
          "selected_candidate_ids",
          "continuation_candidate_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "magic_balance_result_status": {
      "enum": [
        "completed",
        "no_eligible_candidates"
      ]
    },
    "magic_balance_result_total_trials": {
      "type": "integer",
      "minimum": 1
    },
    "magic_simulation_error_error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_json",
            "unsupported_version",
            "invalid_input",
            "simulation_failed"
          ]
        },
        "path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$(?![\\s\\S])"
            },
            {
              "type": "null"
            }
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "code",
        "path",
        "message"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "type": "string",
                "const": "simulation_failed"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "magic_simulation_error_error_path": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?:/(?:[^~/]|~[01])*)*$(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "magic_simulation_error_kind": {
      "type": "string",
      "const": "magic_simulation_error"
    },
    "magic_simulation_error_request_id": {
      "anyOf": [
        {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        {
          "type": "null"
        }
      ]
    },
    "magic_simulation_request_actor": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        "definition_id": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        "side": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_side"
        }
      },
      "required": [
        "id",
        "definition_id",
        "side"
      ],
      "additionalProperties": false
    },
    "magic_simulation_request_attack": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        "source_rule_id": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        "skill": {
          "type": "string",
          "const": "shooting"
        },
        "dice": {
          "type": "integer",
          "minimum": 1
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "damage": {
          "type": "integer",
          "minimum": 0
        },
        "range_min": {
          "enum": [
            "short",
            "medium",
            "long"
          ]
        },
        "range_max": {
          "enum": [
            "short",
            "medium",
            "long"
          ]
        },
        "hands": {
          "enum": [
            "1h",
            "2h"
          ]
        }
      },
      "required": [
        "id",
        "source_rule_id",
        "skill",
        "dice",
        "threshold",
        "damage",
        "range_min",
        "range_max",
        "hands"
      ],
      "additionalProperties": false
    },
    "magic_simulation_request_attack_departure": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        "can_leave_zone": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "can_leave_zone"
      ],
      "additionalProperties": false
    },
    "magic_simulation_request_battlefield": {
      "type": "object",
      "properties": {
        "zone_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "connections": {
          "type": "array",
          "items": {
            "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_connection"
          },
          "minItems": 0
        }
      },
      "required": [
        "zone_ids",
        "connections"
      ],
      "additionalProperties": false
    },
    "magic_simulation_request_broken_plan": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        "kind": {
          "enum": [
            "safe_recover",
            "free_move_recover",
            "free_move_run"
          ]
        },
        "free_move_zone_ids": {
          "type": "array",
          "items": {
            "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "free_move_route": {
          "anyOf": [
            {
              "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_route"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_destination_zone_id": {
          "anyOf": [
            {
              "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "run_route": {
          "anyOf": [
            {
              "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_route"
            },
            {
              "type": "null"
            }
          ]
        },
        "fastest_route_confirmed": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "actor_id",
        "kind",
        "free_move_zone_ids",
        "free_move_route",
        "run_destination_zone_id",
        "run_route",
        "fastest_route_confirmed"
      ],
      "additionalProperties": false
    },
    "magic_simulation_request_connection": {
      "type": "object",
      "properties": {
        "first_zone_id": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        "second_zone_id": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        }
      },
      "required": [
        "first_zone_id",
        "second_zone_id"
      ],
      "additionalProperties": false
    },
    "magic_simulation_request_crushed_rib_continuation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "const": "next_test_with_journal_witnesses"
        }
      ]
    },
    "magic_simulation_request_defeat_decision": {
      "type": "object",
      "properties": {
        "attacker_id": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        "target_id": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        "disposition": {
          "enum": [
            "killed",
            "knocked_out",
            "disarmed_and_surrendered"
          ]
        },
        "gm_approved": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "attacker_id",
        "target_id",
        "disposition",
        "gm_approved"
      ],
      "additionalProperties": false
    },
    "magic_simulation_request_definition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        "source_rule_id": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_id"
        },
        "injury_policy": {
          "enum": [
            "champion",
            "minion"
          ]
        },
        "wound_limit": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "resilience": {
          "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_resilience"
        },
        "attacks": {
          "type": "array",
          "items": {
            "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_attack"
          },
          "minItems": 0,
          "maxItems": 1
        },
        "protection": {
          "type": "array",
          "items": {
            "$ref": "urn:towr:magic:common#/$defs/magic_simulation_request_protection"
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": [
        "id",
        "source_rule_id",
        "injury_policy",
        "wound_limit",
        "resilience",
        "attacks",
        "protection"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "injury_policy": {
                "type": "string",
                "const": "champion"
              }
            }
          },
          "then": {
            "properties": {
              "wound_limit": {
                "type": "null"
              },
              "attacks": {
                "maxItems": 0
              },
              "resilience": {
                "properties": {
                  "bonus": {
                    "type": "integer",
                    "const": 0
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "wound_limit": {
                "type": "integer",
                "const": 1
              },
              "attacks": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "magic_simulation_request_execution": {
      "$ref": "urn:towr:magic:common#/$defs/ranged_simulation_request_execution"
    },
    "magic_simulation_request_facts": {
      "type": "object",
      "properties": {
        "authored_wizard_profile": {
          "type": "boolean",
          "const": true
        },
        "targets_aware": {
          "type": "boolean",
          "const": true
        },
        "clear_line_of_sight": {
          "type": "boolean",
          "const": true
        },
        "all_combatants_included": {
          "type": "boolean",
          "const": true
        },
        "unmounted_combatants_only": {
          "type": "boolean",
          "const": true
        },
        "no_additional_rules": {
          "type": "boolean",
          "const": true
        },
        "no_other_test_modifiers": {
          "type": "boolean",
          "const": true
        },
        "no_cover_or_concealment": {
          "type": "boolean",
          "const": true
        },
        "no_terrain_or_obstacles": {
          "type": "boolean",
          "const": true
        },
        "no_external_scene_changes": {
          "type": "boolean",
          "const": true
        },
        "no_external_condition_sources": {
          "type": "boolean",
          "const": true
