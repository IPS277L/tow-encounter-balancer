      "required": [
        "weapon_skill",
        "strength",
        "toughness",
        "agility",
        "melee",
        "athletics",
        "weapon",
        "armour",
        "abilities",
        "defence",
        "shield",
        "allowed_talents",
        "ballistic_skill",
        "initiative",
        "shooting",
        "dexterity",
        "weapon_count",
        "initial_loaded"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "weapon": {
                "contains": {
                  "const": "ogre_pistol"
                }
              }
            },
            "required": [
              "weapon"
            ]
          },
          "then": {
            "required": [
              "ogre_fit_confirmed"
            ],
            "properties": {
              "ogre_fit_confirmed": {
                "const": true
              }
            }
          },
          "else": {
            "properties": {
              "ogre_fit_confirmed": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "candidate": {
      "type": "object",
      "properties": {
        "npcs": {
          "type": "array",
          "items": {
            "$ref": "urn:towr:pc-melee:common:1#/$defs/generated_components"
          },
          "minItems": 1
        },
        "win_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "win_interval_95": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "mean_started_rounds": {
          "type": "number",
          "minimum": 1
        },
        "rounds_interval_95": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "outcomes": {
          "type": "object",
          "properties": {
            "objective_achieved": {
              "type": "integer",
              "minimum": 0
            },
            "party_defeated": {
              "type": "integer",
              "minimum": 0
            },
            "round_limit": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported_path": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "objective_achieved",
            "party_defeated",
            "round_limit",
            "unsupported_path"
          ],
          "additionalProperties": false
        },
        "trials": {
          "type": "integer",
          "minimum": 1
        },
        "replay": {
          "$ref": "urn:towr:pc-melee:simulation:request:1"
        },
        "potion_use_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:towr:pc-melee:common:1#/$defs/potionUseCount"
          }
        },
        "magic_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:towr:pc-melee:common:1#/$defs/magicCount"
          }
        },
        "npc_ranged_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:towr:pc-melee:common:1#/$defs/npcRangedCount"
          }
        },
        "pc_ranged_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:towr:pc-melee:common:1#/$defs/pcRangedCount"
          }
        },
        "target_assessment": {
          "$ref": "#/$defs/target_assessment"
        }
      },
      "required": [
        "npcs",
        "win_rate",
        "win_interval_95",
        "mean_started_rounds",
        "rounds_interval_95",
        "outcomes",
        "trials",
        "replay",
        "target_assessment"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "replay": {
                "properties": {
                  "scenario": {
                    "properties": {
                      "party": {
                        "contains": {
                          "properties": {
                            "consumables": {
                              "minItems": 1
                            }
                          },
                          "required": [
                            "consumables"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "potion_use_counts"
            ]
          },
          "else": {
            "not": {
              "required": [
                "potion_use_counts"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "replay": {
                "properties": {
                  "scenario": {
                    "properties": {
                      "party": {
                        "contains": {
                          "properties": {
                            "wizard": {
                              "type": "object"
                            }
                          },
                          "required": [
                            "wizard"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "magic_counts"
            ]
          },
          "else": {
            "not": {
              "required": [
                "magic_counts"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "replay"
            ],
            "properties": {
              "replay": {
                "required": [
                  "scenario"
                ],
                "properties": {
                  "scenario": {
                    "required": [
                      "enemies"
                    ],
                    "properties": {
                      "enemies": {
                        "contains": {
                          "required": [
                            "ranged"
                          ],
                          "properties": {
                            "ranged": {
                              "type": "object"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "npc_ranged_counts"
            ]
          },
          "else": {
            "not": {
              "required": [
                "npc_ranged_counts"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "replay"
            ],
            "properties": {
              "replay": {
                "required": [
                  "scenario"
                ],
                "properties": {
                  "scenario": {
                    "required": [
                      "party"
                    ],
                    "properties": {
                      "party": {
                        "contains": {
                          "required": [
                            "policy",
                            "pc"
                          ],
                          "properties": {
                            "policy": {
                              "const": "automatic_combat"
