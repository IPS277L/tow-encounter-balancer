              "armour_of_agilulf",
              "armour_of_meteoric_iron",
              "mantle_of_ithilmar"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "helmet": {
          "type": "array",
          "items": {
            "enum": [
              null,
              "helmet",
              "helm_of_the_hunt"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "rider_kind": {
          "type": "array",
          "items": {
            "enum": [
              "human",
