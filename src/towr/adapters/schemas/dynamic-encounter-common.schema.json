{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:dynamic-encounter:common:1",
  "$defs": {
    "party_member": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "urn:towr:pc-melee:common:1#/$defs/identifier"
        },
        "characteristics": {
          "type": "object",
          "properties": {
            "weapon_skill": {
              "type": "integer",
              "minimum": 1
            },
            "strength": {
              "type": "integer",
              "minimum": 1
            },
            "toughness": {
              "type": "integer",
              "minimum": 1
            },
            "agility": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "weapon_skill",
            "strength",
            "toughness",
            "agility"
          ],
          "additionalProperties": false
        },
        "skills": {
          "type": "object",
          "properties": {
            "melee": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "defence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "athletics": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "endurance": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "willpower": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "melee",
            "defence",
            "athletics",
            "endurance"
          ],
          "additionalProperties": false
        },
        "equipment": {
          "type": "object",
          "properties": {
            "weapons": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/weapon_item"
              }
            },
            "armour": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/armour_item"
              }
            }
          },
          "required": [
            "weapons",
            "armour"
          ],
          "additionalProperties": false
        },
        "talents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "object",
          "properties": {
            "fate": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "fate"
          ],
          "additionalProperties": false
        },
        "consumables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consumable_item"
          }
        },
        "magic": {
          "$ref": "#/$defs/magic"
        },
        "talent_acquisition": {
          "type": "object",
          "properties": {
            "defensive_stance": {
              "enum": [
                "earned",
                "creation_free"
              ]
            },
            "wild_attack": {
              "enum": [
                "earned",
                "creation_free"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "actor_id",
        "characteristics",
        "skills",
        "equipment",
        "talents",
        "resources",
        "consumables"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "magic"
            ]
          },
          "then": {
            "properties": {
              "characteristics": {
                "required": [
                  "reason"
                ]
              },
              "skills": {
                "required": [
                  "willpower"
                ]
              },
              "talents": {
                "contains": {
                  "const": "wizard"
                }
              }
            }
          },
          "else": {
            "properties": {
              "characteristics": {
                "not": {
                  "required": [
                    "reason"
                  ]
                }
              },
              "skills": {
                "not": {
                  "required": [
                    "willpower"
                  ]
                }
              },
              "talents": {
                "not": {
                  "contains": {
                    "const": "wizard"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "talent_acquisition"
            ],
            "properties": {
              "talent_acquisition": {
                "required": [
                  "defensive_stance"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "talents": {
                "contains": {
                  "const": "defensive_stance"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "talent_acquisition"
            ],
            "properties": {
              "talent_acquisition": {
                "required": [
                  "wild_attack"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "talents": {
                "contains": {
                  "const": "wild_attack"
                }
              }
            }
          }
        }
      ]
    },
    "search_space": {
      "type": "object",
      "properties": {
        "weapon_skill": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "strength": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "toughness": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "agility": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "melee": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 6
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "athletics": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 6
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "weapon": {
          "type": "array",
          "items": {
            "enum": [
              "staff",
              "dagger",
              "axe",
              "sword",
              "warhammer",
              "morning_star"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "light_armour": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "abilities": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "enum": [
                "drained_on_hit"
              ]
            },
            "uniqueItems": true
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "defence": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 6
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "shield": {
          "type": "array",
          "items": {
            "type": "boolean"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "allowed_talents": {
          "type": "array",
          "items": {
            "$ref": "urn:towr:pc-melee:common:1#/$defs/generated_talent"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "weapon_skill",
        "strength",
        "toughness",
        "agility",
        "melee",
        "athletics",
        "weapon",
        "light_armour",
        "abilities",
        "defence",
        "shield",
        "allowed_talents"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "npcs": {
          "type": "array",
          "items": {
            "$ref": "urn:towr:pc-melee:common:1#/$defs/generated_components"
          },
          "minItems": 1
        },
        "win_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "win_interval_95": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "mean_started_rounds": {
          "type": "number",
          "minimum": 1
        },
        "rounds_interval_95": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "outcomes": {
          "type": "object",
          "properties": {
            "objective_achieved": {
              "type": "integer",
              "minimum": 0
            },
            "party_defeated": {
              "type": "integer",
              "minimum": 0
            },
            "round_limit": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported_path": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "objective_achieved",
            "party_defeated",
            "round_limit",
            "unsupported_path"
          ],
          "additionalProperties": false
        },
        "trials": {
          "type": "integer",
          "minimum": 1
        },
        "replay": {
          "$ref": "urn:towr:pc-melee:simulation:request:1"
        },
        "potion_use_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:towr:pc-melee:common:1#/$defs/potionUseCount"
          }
        },
        "magic_counts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:towr:pc-melee:common:1#/$defs/magicCount"
          }
        }
      },
      "required": [
        "npcs",
        "win_rate",
        "win_interval_95",
        "mean_started_rounds",
        "rounds_interval_95",
        "outcomes",
        "trials",
        "replay"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "replay": {
                "properties": {
                  "scenario": {
                    "properties": {
                      "party": {
                        "contains": {
                          "properties": {
                            "consumables": {
                              "minItems": 1
                            }
                          },
                          "required": [
                            "consumables"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "potion_use_counts"
            ]
          },
          "else": {
            "not": {
              "required": [
                "potion_use_counts"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "replay": {
                "properties": {
                  "scenario": {
                    "properties": {
                      "party": {
                        "contains": {
                          "properties": {
                            "wizard": {
                              "type": "object"
                            }
                          },
                          "required": [
                            "wizard"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "magic_counts"
            ]
          },
          "else": {
            "not": {
              "required": [
                "magic_counts"
              ]
            }
          }
        }
      ]
    },
    "scene": {
      "type": "object",
      "properties": {
        "range": {
          "const": "close"
        },
        "ambush": {
          "const": "none"
        },
        "terrain": {
          "const": "open"
        },
        "session_start": {
          "const": "fresh"
        }
      },
      "required": [
        "range",
        "ambush",
        "terrain",
        "session_start"
      ],
      "additionalProperties": false
    },
    "weapon_item": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:towr:pc-melee:common:1#/$defs/identifier"
        },
        "weapon": {
          "enum": [
            "staff",
            "sword",
            "dagger",
            "axe",
            "warhammer",
            "morning_star",
            "pickaxe",
            "flail",
            "billhook",
            "halberd",
            "glaive",
            "greataxe",
            "greathammer"
          ]
        },
        "location": {
          "enum": [
            "carried",
            "left_hand",
            "right_hand",
            "both_hands"
          ]
        }
      },
      "required": [
        "id",
        "weapon",
        "location"
      ],
      "additionalProperties": false
    },
    "armour_item": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:towr:pc-melee:common:1#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "light_armour",
            "heavy_armour",
            "helmet",
            "shield"
          ]
        },
        "location": {
          "enum": [
            "carried",
            "left_hand",
            "right_hand",
            "worn"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "location"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "shield"
              }
            }
          },
          "then": {
            "properties": {
              "location": {
                "enum": [
                  "carried",
                  "left_hand",
                  "right_hand"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "location": {
                "enum": [
                  "carried",
                  "worn"
                ]
              }
            }
          }
        }
      ]
    },
    "consumable_item": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:towr:pc-melee:common:1#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "healing_potion",
            "enhancement_potion"
          ]
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "characteristic": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "quantity",
        "characteristic"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "enhancement_potion"
              }
            }
          },
          "then": {
            "properties": {
              "characteristic": {
                "enum": [
                  "weapon_skill",
                  "ballistic_skill",
                  "strength",
                  "toughness",
                  "initiative",
                  "agility",
                  "reason",
                  "fellowship"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "characteristic": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "magic": {
      "type": "object",
      "properties": {
        "origin": {
          "enum": [
            "human",
            "dwarf",
            "halfling",
            "high_elf",
            "wood_elf",
            "ogre"
          ]
        },
        "wizard_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "lores": {
          "type": "array",
          "items": {
            "const": "elementalism"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "memorised_spells": {
          "type": "array",
          "items": {
            "enum": [
              "lightning_blast",
              "fire_breath"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "arcane_paraphernalia": {
          "type": "boolean"
        }
      },
      "required": [
        "origin",
        "wizard_level",
        "lores",
        "memorised_spells",
        "arcane_paraphernalia"
      ],
      "additionalProperties": false
    }
  }
}
