            "type": "boolean"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "agilulf_code_confirmed": {
          "enum": [
            null,
            true
          ]
        },
        "weapon_count": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "initial_loaded": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "boolean"
          }
        },
        "endurance": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 6
          },
          "minItems": 1,
