{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:dynamic-encounter:common:1",
  "$defs": {
    "party_member": {
      "type": "object",
      "properties": {
        "actor_id": {
          "$ref": "urn:towr:pc-melee:common:1#/$defs/identifier"
        },
        "characteristics": {
          "type": "object",
          "properties": {
            "weapon_skill": {
              "type": "integer",
              "minimum": 1
            },
            "strength": {
              "type": "integer",
              "minimum": 1
            },
            "toughness": {
              "type": "integer",
              "minimum": 1
            },
            "agility": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "integer",
              "minimum": 1
            },
            "ballistic_skill": {
              "type": "integer",
              "minimum": 1
            },
            "initiative": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "weapon_skill",
            "strength",
            "toughness",
            "agility"
          ],
          "additionalProperties": false
        },
        "skills": {
          "type": "object",
          "properties": {
            "melee": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "defence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "athletics": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "endurance": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "willpower": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "shooting": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "dexterity": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "awareness": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "throwing": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "brawn": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            }
          },
          "required": [
            "melee",
            "defence",
            "athletics",
            "endurance"
          ],
          "additionalProperties": false
        },
        "equipment": {
          "type": "object",
          "properties": {
            "weapons": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/weapon_item"
              }
            },
            "armour": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/armour_item"
              }
            },
            "armour_benefit_id": {
              "$ref": "urn:towr:pc-melee:common:1#/$defs/identifier"
            }
          },
          "required": [
            "weapons",
            "armour"
          ],
          "additionalProperties": false
        },
        "talents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "resources": {
          "type": "object",
          "properties": {
            "fate": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "fate"
          ],
          "additionalProperties": false
        },
        "consumables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/consumable_item"
          }
        },
        "magic": {
          "$ref": "#/$defs/magic"
        },
        "talent_acquisition": {
          "type": "object",
          "properties": {
            "defensive_stance": {
              "enum": [
                "earned",
                "creation_free"
              ]
            },
            "wild_attack": {
              "enum": [
                "earned",
                "creation_free"
              ]
            }
          },
          "additionalProperties": false
        },
        "ranged": {
          "$ref": "#/$defs/player_ranged_preparation"
        },
        "mount": {
          "enum": [
            null,
            "horse",
            "bretonnian_warhorse",
            "elven_steed",
            "skeletal_steed",
            "demigryph",
            "pegasus"
          ]
        },
        "rider_kind": {
          "enum": [
            null,
            "human",
            "elf",
            "other"
          ]
        },
        "agilulf_code_confirmed": {
          "enum": [
            null,
            true
          ]
        }
      },
      "required": [
        "actor_id",
        "characteristics",
        "skills",
        "equipment",
        "talents",
        "resources",
        "consumables"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "magic"
            ]
          },
          "then": {
            "properties": {
              "characteristics": {
                "required": [
                  "reason"
                ]
              },
              "skills": {
                "required": [
                  "willpower"
                ]
              },
              "talents": {
                "contains": {
                  "const": "wizard"
                }
              }
            }
          },
          "else": {
            "properties": {
              "characteristics": {
                "not": {
                  "required": [
                    "reason"
                  ]
                }
              },
              "skills": {
                "not": {
                  "required": [
                    "willpower"
                  ]
                }
              },
              "talents": {
                "not": {
                  "contains": {
                    "const": "wizard"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "talent_acquisition"
            ],
            "properties": {
              "talent_acquisition": {
                "required": [
                  "defensive_stance"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "talents": {
                "contains": {
                  "const": "defensive_stance"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "talent_acquisition"
            ],
            "properties": {
              "talent_acquisition": {
                "required": [
                  "wild_attack"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "talents": {
                "contains": {
                  "const": "wild_attack"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mount"
            ],
            "properties": {
              "mount": {
                "const": "demigryph"
              }
            }
          },
          "then": {
            "required": [
              "rider_kind"
            ],
            "properties": {
              "rider_kind": {
                "enum": [
                  "human"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "mount"
            ],
            "properties": {
              "mount": {
                "const": "pegasus"
              }
            }
          },
          "then": {
            "required": [
              "rider_kind"
            ],
            "properties": {
              "rider_kind": {
                "enum": [
                  "human",
                  "elf"
                ]
              }
            }
          }
        },
        {
          "if": {
            "not": {
              "required": [
                "mount"
              ],
              "properties": {
                "mount": {
                  "enum": [
                    "demigryph",
                    "pegasus"
                  ]
                }
              }
            }
          },
          "then": {
            "properties": {
              "rider_kind": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "properties": {
                  "equipment": {
                    "properties": {
                      "weapons": {
                        "not": {
                          "contains": {
                            "properties": {
                              "location": {
                                "enum": [
                                  "left_hand",
                                  "right_hand",
                                  "both_hands"
                                ]
                              }
                            },
                            "required": [
                              "location"
                            ]
                          }
                        }
                      }
                    }
                  }
                }
              },
              {
                "properties": {
                  "equipment": {
                    "properties": {
                      "weapons": {
                        "contains": {
                          "properties": {
                            "weapon": {
                              "const": "knuckledusters"
                            }
                          },
                          "required": [
                            "weapon"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            ]
          },
          "then": {
            "properties": {
              "skills": {
                "required": [
                  "brawn"
                ]
              }
            }
          }
        }
      ]
    },
    "search_space": {
      "type": "object",
      "properties": {
        "weapon_skill": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
