      "required": ["scenario_id", "definitions", "actors", "battlefield", "placements", "side_order", "activation_order", "perspective_side", "objective_target_ids", "facts", "wizard", "spell", "actor_policies", "scene_frames", "repeated_stagger_choice", "miscast_continuation", "stationary_wound_continuation", "repeated_leg_spasm_continuation", "crushed_rib_continuation"],
