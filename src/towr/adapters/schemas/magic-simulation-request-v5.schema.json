        "actor_policies": {"$ref": "urn:towr:magic-simulation:request:1#/$defs/scenario/properties/actor_policies"},
        "scene_frames": {"$ref": "urn:towr:magic-simulation:request:1#/$defs/scenario/properties/scene_frames"},
        "repeated_stagger_choice": {"$ref": "urn:towr:magic-simulation:request:1#/$defs/scenario/properties/repeated_stagger_choice"},
        "miscast_continuation": {"$ref": "urn:towr:magic-simulation:request:2#/$defs/miscast_continuation"},
        "stationary_wound_continuation": {"$ref": "urn:towr:magic-simulation:request:3#/$defs/stationary_wound_continuation"},
        "repeated_leg_spasm_continuation": {"$ref": "urn:towr:magic-simulation:request:4#/$defs/repeated_leg_spasm_continuation"},
