{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:magic-simulation:request:5",
  "$comment": "ADR-0058: four required nullable permissions; Crushed Rib remains fresh-source-only and uses bundled earlier fragments.",
  "type": "object",
  "properties": {
    "schema_version": {"type": "string", "const": "5"},
    "kind": {"$ref": "urn:towr:magic-simulation:request:1#/properties/kind"},
