{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:ranged-simulation:result:1",
  "$comment": "Structural contract. Strict token spelling and semantic admission are adapter responsibilities.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "kind": {
      "type": "string",
      "const": "npc_ranged_simulation_result"
    },
    "request": {
      "$ref": "urn:towr:ranged-simulation:request:1"
    },
    "seed_scheme": {
      "type": "string",
      "const": "towr:npc-ranged-trial:v1"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "package_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "python_implementation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "python_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rng": {
          "type": "string",
          "const": "random.Random"
        }
      },
      "required": [
        "package_version",
        "python_implementation",
        "python_version",
        "rng"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "outcome_counts": {
          "type": "object",
          "properties": {
            "objective_achieved": {
              "type": "integer",
              "minimum": 0
            },
            "side_defeated": {
              "type": "integer",
              "minimum": 0
            },
            "round_limit": {
              "type": "integer",
              "minimum": 0
            },
            "unsupported_path": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "objective_achieved",
            "side_defeated",
            "round_limit",
            "unsupported_path"
          ],
          "additionalProperties": false
        },
        "total_attack_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_visited_round_count": {
          "type": "integer",
          "minimum": 1
        },
        "mean_attack_count": {
          "type": "number",
          "minimum": 0
        },
        "mean_visited_round_count": {
          "type": "number",
          "minimum": 1
        }
      },
      "required": [
        "outcome_counts",
        "total_attack_count",
        "total_visited_round_count",
        "mean_attack_count",
        "mean_visited_round_count"
      ],
      "additionalProperties": false
    },
    "trials": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "trial_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 18446744073709551615
          },
          "seed_hex": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "minLength": 64,
            "maxLength": 64
          },
          "outcome": {
            "enum": [
              "objective_achieved",
              "side_defeated",
              "round_limit",
              "unsupported_path"
            ]
          },
          "executed_attack_count": {
            "type": "integer",
            "minimum": 0
          },
          "visited_round_count": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "trial_index",
          "seed_hex",
          "outcome",
          "executed_attack_count",
          "visited_round_count"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "request",
    "seed_scheme",
    "runtime",
    "summary",
    "trials"
  ],
  "additionalProperties": false
}
