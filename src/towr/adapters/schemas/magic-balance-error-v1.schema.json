{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:towr:magic-balance:error:1",
  "$comment": "Structural contract. Strict tokens, source chains and derived values are checked by typed adapters.",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "kind": {
      "type": "string",
      "const": "magic_balance_error"
    },
    "request_id": {
      "anyOf": [
        {
          "$ref": "urn:towr:magic-simulation:request:1#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "invalid_json",
            "unsupported_version",
            "invalid_input",
            "generation_failed",
            "evaluation_failed"
          ]
        },
        "path": {
          "$ref": "urn:towr:magic-simulation:error:1#/properties/error/properties/path"
        },
        "message": {
          "$ref": "urn:towr:magic-simulation:request:1#/$defs/id"
        },
        "candidate_id": {
          "anyOf": [
            {
              "$ref": "urn:towr:magic-simulation:request:1#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "minItems": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "stage_index": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "path",
        "message",
        "candidate_id",
        "counts",
        "stage_index"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "invalid_json",
                  "unsupported_version",
                  "invalid_input"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "candidate_id": {
                "type": "null"
              },
              "counts": {
                "type": "null"
              },
              "stage_index": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "generation_failed"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "const": "/generation"
              },
              "stage_index": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "evaluation_failed"
              }
            }
          },
          "then": {
            "properties": {
              "path": {
                "type": "string",
                "const": "/evaluation"
              },
              "counts": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "request_id",
    "error"
  ],
  "additionalProperties": false
}
